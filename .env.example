TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
OPENROUTER_API_KEY=sk-or-v1-PASTE_OPENROUTER_KEY_HERE
# Public HTTPS origin of this Mini App, for example https://your-app.amvera.io.
QUICK_ACTIONS_BASE_URL=
# Comma-separated numeric Telegram chat IDs. Realtime Beta is visible only here.
ADMIN_CHAT_IDS=

# Optional managed OpenRouter user keys. Leave all three empty to use the shared key only.
OPENROUTER_MANAGEMENT_API_KEY=
USER_SECRETS_MASTER_KEY=
NOEMA_USER_MONTHLY_LIMIT_USD=2

FAST_MODEL=qwen/qwen3.5-flash-02-23
# FAST_MODEL is the one global primary LLM. Admin may change it live.
# Legacy GLOBAL_MODEL_MODE / GLOBAL_FORCE_MODEL are intentionally ignored.
GLOBAL_VISION_MODE=auto
GLOBAL_FORCE_VISION_MODEL=
FAST_MODEL_PROVIDERS=alibaba
FAST_MODEL_ALLOW_PROVIDER_FALLBACK=false
STRONG_MODEL=deepseek/deepseek-v3.2
STRONG_MODEL_PROVIDERS=streamlake,deepinfra
STRONG_MODEL_ALLOW_PROVIDER_FALLBACK=true
MODEL_CATALOG=qwen/qwen3.5-flash-02-23,deepseek/deepseek-v3.2,google/gemini-2.5-flash,google/gemini-2.5-pro,anthropic/claude-sonnet-4,openai/gpt-4.1
CHAT_MAX_TOKENS=6000
# Amvera uses /data automatically. Locally this may point to another durable folder.
# DATA_DIR=/data

# Safe generated artifacts are stored under DATA_DIR/artifacts and expire automatically.
ARTIFACT_MAX_MB=15
ARTIFACT_TTL_HOURS=72

# Production voice: tap → record → batch STT → streaming response. These are canonical names.
BATCH_STT_MODEL=mistralai/voxtral-mini-transcribe
BATCH_STT_TIMEOUT_SEC=180
# One-release compatibility only: if BATCH_STT_MODEL is absent, STT_MODEL is read.
# STT_MODEL=mistralai/voxtral-mini-transcribe
# Retired, never read by the runtime: STT_PROVIDER, STT_FALLBACK_MODEL, STT_REALTIME_MODEL.

# Experimental Realtime Beta only. Server-only key: never sent to the browser.
MISTRAL_API_KEY=
MISTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_CLIENT_SESSIONS_URL=https://api.mistral.ai/v1/client/sessions

VISION_MODEL=google/gemini-2.5-flash-lite
VISION_FALLBACK_MODELS=google/gemini-2.5-flash-lite
TELEGRAM_DRAFT_STREAMING_ENABLED=false
# Retired for ordinary private text: that path always uses persistent preview
# promotion, even if a deployment still sets the legacy flag to true.
# Safe against Telegram's 40 updates / 30 seconds per-chat limit.
TELEGRAM_DRAFT_MIN_INTERVAL=0.4
TELEGRAM_DRAFT_MAX_INTERVAL=0.45
TELEGRAM_DRAFT_MIN_CHARS=12
# A real burst of this many newly visible characters bypasses the time gate
# once, so a fast provider still produces an in-place intermediate edit.
TELEGRAM_STREAM_FORCE_EDIT_CHARS=64
# Temporary privacy-safe production trace: request id, hashed chat id, event
# type and counters only; never user/model text.
TELEGRAM_LIVE_STREAM_TELEMETRY=true
TELEGRAM_SEND_RETRIES=1
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_READ_TIMEOUT=15
TELEGRAM_WRITE_TIMEOUT=15
TELEGRAM_POOL_TIMEOUT=3
TELEGRAM_CONNECTION_POOL_SIZE=32
REMINDER_TICK_SECONDS=20
# Disabled by default. Keeps only bounded numeric latency samples in memory.
TELEMETRY_ENABLED=false
TELEMETRY_SERIES_LIMIT=2048
# Semantic production is shipped inert. Use a comma-separated trusted-owner
# allowlist for a canary, or exactly * only for an approved global rollout.
SEMANTIC_RUNTIME_MODE=off
SEMANTIC_CANARY_USER_IDS=
EDGE_VOICE=ru-RU-DmitryNeural
# Semantic voice slots. Users save only male/female; a live admin change of
# either slot is used on their next answer. EDGE_VOICE remains the male alias
# for one release.
TTS_MALE_VOICE=ru-RU-DmitryNeural
TTS_FEMALE_VOICE=ru-RU-SvetlanaNeural
# Safe voice routing defaults. Admin may override these live; no API key belongs here.
TTS_PROVIDER=edge
TTS_FALLBACK_PROVIDER=browser
TTS_DEFAULT_SPEED=1.0
TTS_DEFAULT_PITCH=1.0
TTS_DEFAULT_VOLUME=1.0

TIMEZONE=Europe/Amsterdam
DEFAULT_CITY=Санкт-Петербург
VOICE_REPLY_MODE=text
MAX_FILE_MB=20
# Amvera listens on 8080 by default. Override only when the platform requires it.
NOEMA_QUICK_PORT=8080
