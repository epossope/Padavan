TELEGRAM_BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
OPENROUTER_API_KEY=sk-or-v1-PASTE_OPENROUTER_KEY_HERE
# Comma-separated numeric Telegram chat IDs. Realtime Beta is visible only here.
ADMIN_CHAT_IDS=

FAST_MODEL=qwen/qwen3.5-flash-02-23
FAST_MODEL_PROVIDERS=alibaba
FAST_MODEL_ALLOW_PROVIDER_FALLBACK=false
STRONG_MODEL=deepseek/deepseek-v3.2
STRONG_MODEL_PROVIDERS=streamlake,deepinfra
STRONG_MODEL_ALLOW_PROVIDER_FALLBACK=true
MODEL=qwen/qwen3.5-flash-02-23
FALLBACK_MODELS=deepseek/deepseek-v3.2
AVAILABLE_MODELS=qwen/qwen3.5-flash-02-23,deepseek/deepseek-v3.2,google/gemini-2.5-flash,google/gemini-2.5-pro,anthropic/claude-sonnet-4,openai/gpt-4.1
CHAT_MAX_TOKENS=1800
# Amvera uses /data automatically. Locally this may point to another durable folder.
# DATA_DIR=/data

VISION_MODEL=google/gemini-2.5-flash-lite
VISION_FALLBACK_MODELS=google/gemini-2.5-flash-lite

STT_MODEL=mistralai/voxtral-mini-transcribe
# Server-only key. Put it in local .env / Amvera Secrets; it is never sent to the browser.
MISTRAL_API_KEY=
MISTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
VOICE_CONVERSATION_ENABLED=true
VOICE_MODE=conversation
TELEGRAM_DRAFT_STREAMING_ENABLED=true
# Safe against Telegram's 40 updates / 30 seconds per-chat limit.
TELEGRAM_DRAFT_MIN_INTERVAL=0.8
TELEGRAM_DRAFT_MAX_INTERVAL=1.2
TELEGRAM_DRAFT_MIN_CHARS=24
TELEGRAM_SEND_RETRIES=1
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_READ_TIMEOUT=15
TELEGRAM_WRITE_TIMEOUT=15
TELEGRAM_POOL_TIMEOUT=3
TELEGRAM_CONNECTION_POOL_SIZE=32
REMINDER_TICK_SECONDS=20
# Disabled by default. Keeps only bounded numeric latency samples in memory.
TELEMETRY_ENABLED=false
TELEMETRY_SERIES_LIMIT=2048
EDGE_VOICE=ru-RU-DmitryNeural

TIMEZONE=Europe/Amsterdam
DEFAULT_CITY=Санкт-Петербург
VOICE_REPLY_MODE=auto
MAX_FILE_MB=20
